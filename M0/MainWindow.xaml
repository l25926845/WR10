<Window x:Class="FullScreenStart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FullScreenStart"
        Title="全屏开始菜单"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        KeyboardNavigation.DirectionalNavigation="Contained"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <!-- Win10 全屏开始菜单为纯黑底，磁贴颜色直接铺在黑底上 -->
    <Window.Background>
        <SolidColorBrush Color="#FF000000"/>
    </Window.Background>

    <Window.Resources>
        <!-- 底栏按钮：账户 / 电源 -->
        <Style x:Key="BarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 搜索框：深色圆角，左右留出图标与提示的空间 -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FF232323"/>
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="CaretBrush" Value="#FFEDEDED"/>
            <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0,34,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 所有应用列表行 -->
        <Style x:Key="AllAppRowStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 所有应用只保留数据容器，不显示 ListBox 自身的选中背景 -->
        <Style x:Key="AllAppListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右侧字母索引按钮 -->
        <Style x:Key="LetterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFA6A6A6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Width="20"
                                Height="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 磁贴容器：悬停/选中只提亮磁贴，不改变占位尺寸 -->
        <Style x:Key="TileContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="AllowDrop" Value="True"/>
            <!-- 供虚拟化磁贴面板读取占位档位，避免依赖容器的测量缓存 -->
            <Setter Property="Tag" Value="{Binding Size}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <ContentPresenter/>
                            <Border x:Name="Overlay"
                                    Background="Transparent"
                                    IsHitTestVisible="False"/>
                            <!-- 按下时压暗一层，松手/移出后由代码复位 -->
                            <Border x:Name="Pressed"
                                    Background="#40000000"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Tile_Click"/>
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="Tile_RightClick"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Tile_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="PreviewMouseMove" Handler="Tile_PreviewMouseMove"/>
            <EventSetter Event="MouseLeave" Handler="Tile_MouseLeave"/>
            <EventSetter Event="DragOver" Handler="Tile_DragOver"/>
            <EventSetter Event="Drop" Handler="Tile_Drop"/>
        </Style>

        <!-- 磁贴外观：Win10 直角磁贴，1x1 也在左下角显示应用名 -->
        <!-- 只设 DataType 不设 x:Key，这样 WPF 会把它注册为 TileItem 的隐式模板，
             扁平列表与搜索结果都能自动套用，无需再显式引用 -->
        <DataTemplate DataType="{x:Type local:TileItem}">
            <Border Width="{Binding TileWidth}"
                    Height="{Binding TileHeight}"
                    Background="{Binding ColorBrush}">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Margin" Value="10"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSmall}" Value="True">
                                    <Setter Property="Margin" Value="6"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="{Binding Letter}"
                                   FontSize="{Binding LetterSize}"
                                   Foreground="#CCFFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPlaceholder}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image Source="{Binding Icon}"
                               Width="{Binding IconSize}"
                               Height="{Binding IconSize}"
                               Stretch="Uniform"/>
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Style.Triggers>
                                    <!-- 小磁贴字号更小，并允许换两行，避免长名称被截掉 -->
                                    <DataTrigger Binding="{Binding IsSmall}" Value="True">
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="LineHeight" Value="13"/>
                                        <Setter Property="MaxHeight" Value="26"/>
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 所有应用的字母标题与应用行共用扁平 ListBox，按数据类型自动选模板 -->
        <DataTemplate DataType="{x:Type local:AllAppsSection}">
            <TextBlock Text="{Binding Key}"
                       FontSize="16"
                       Foreground="#FFD0D0D0"
                       Margin="4,8,0,14"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:AllAppItem}">
            <Button Style="{StaticResource AllAppRowStyle}"
                    AutomationProperties.Name="{Binding Name}"
                    Click="AllApp_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Icon}"
                           Width="24"
                           Height="24"
                           Stretch="Uniform"/>
                    <TextBlock Text="{Binding Name}"
                               FontSize="13"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- 分组标题：FlatTileList 里 GroupHeaderItem 自动匹配，整行显示分组名 -->
        <DataTemplate DataType="{x:Type local:GroupHeaderItem}">
            <TextBlock Text="{Binding GroupName}"
                       FontSize="15"
                       Foreground="#FFE4E4E4"
                       Margin="4,14,0,10"
                       MouseRightButtonUp="Group_RightClick"/>
        </DataTemplate>

        <!-- 深色细滚动条，避免纯黑背景上出现浅色系统滚动条 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#59FFFFFF"
                                                        CornerRadius="4"
                                                        Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="40,28,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="6,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="AllAppsButton"
                        Style="{StaticResource BarButtonStyle}"
                        Padding="6,4"
                        AutomationProperties.Name="所有应用"
                        ToolTip="所有应用"
                        Click="AllApps_Click">
                    <TextBlock x:Name="MenuGlyph"
                               Text="&#xE700;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="22"
                               Foreground="#FFEDEDED"
                               VerticalAlignment="Center"/>
                </Button>
                <TextBlock Text="开始"
                           FontSize="22"
                           FontWeight="Light"
                           Foreground="#FFEDEDED"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Width="260" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource SearchBoxStyle}"
                         TextChanged="SearchBox_TextChanged"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                <TextBlock x:Name="SearchPlaceholder"
                           Text="搜索应用"
                           Foreground="#FF8A8A8A"
                           FontSize="13"
                           Margin="13,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
                <TextBlock Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="#FF8A8A8A"
                           HorizontalAlignment="Right"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 扁平磁贴 ListBox：去掉外层 ScrollViewer，让 ListBox 自带的 ScrollViewer 成为滚动主体。
                 VirtualizingTilePanel 在这里实现多列多尺寸网格布局 + UI 虚拟化，
                 只生成可视区域的容器，从根源上解决 376 磁贴全实例化导致的内存浪费。
                 FlatTileList 不设 ItemTemplate，WPF 会自动按 DataType 匹配 TileItem / GroupHeaderItem。 -->
            <ListBox x:Name="FlatTileList"
                     Grid.Column="0"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource TileContainerStyle}"
                     SelectionMode="Single"
                     SelectionChanged="FlatTileList_SelectionChanged"
                     MouseRightButtonUp="Content_RightClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     KeyboardNavigation.DirectionalNavigation="Contained">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:VirtualizingTilePanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <!-- 搜索结果使用固定高度的网格行，确保虚拟化面板拿到有限视口高度 -->
            <Grid x:Name="SearchPanel" Grid.Column="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="SearchHeader"
                           Text="搜索结果"
                           FontSize="15"
                           Foreground="#FFE4E4E4"
                           Margin="4,14,0,10"/>
                <ListBox x:Name="SearchResults"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource TileContainerStyle}"
                         SelectionMode="Single"
                         SelectionChanged="FlatTileList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         KeyboardNavigation.DirectionalNavigation="Contained">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:VirtualizingTilePanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <TextBlock x:Name="SearchEmpty"
                           Grid.Row="1"
                           Text="没有找到匹配的应用"
                           FontSize="15"
                           Foreground="#FF8A8A8A"
                           Margin="6,4,0,0"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- 所有应用：分组标题与应用行扁平混排，由 ListBox 自己滚动并虚拟化 -->
            <Grid x:Name="AllAppsPanel" Grid.Column="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="所有应用"
                           FontSize="15"
                           Foreground="#FFE4E4E4"
                           Margin="4,14,0,10"/>
                <ListBox x:Name="AllAppsList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource AllAppListItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         LayoutUpdated="AllAppsList_LayoutUpdated">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Grid>

            <ItemsControl x:Name="LetterIndex"
                          Grid.Column="1"
                          Width="40"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="0,0,4,0"
                          Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource LetterButtonStyle}"
                                Content="{Binding}"
                                Click="Letter_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="AccountButton"
                    Style="{StaticResource BarButtonStyle}"
                    AutomationProperties.Name="账户"
                    Click="Account_Click">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="14" Background="#FF3A3A3A">
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="#FFEDEDED"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="UserNameText"
                               FontSize="13"
                               Foreground="#FFEDEDED"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="Esc 收起 · Ctrl+Alt+Space 唤起 · 右键调整"
                       Foreground="#FF7A7A7A"
                       FontSize="12"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>

            <Button Grid.Column="2"
                    x:Name="PowerButton"
                    Style="{StaticResource BarButtonStyle}"
                    AutomationProperties.Name="电源"
                    ToolTip="电源"
                    Click="Power_Click">
                <TextBlock Text="&#xE7E8;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="17"
                           Foreground="#FFEDEDED"/>
            </Button>
        </Grid>
    </Grid>
</Window>
