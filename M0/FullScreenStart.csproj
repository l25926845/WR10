<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FullScreenStart</AssemblyName>
    <RootNamespace>FullScreenStart</RootNamespace>

    <!-- 发布信息：写进 exe 属性，便于分发时识别版本 -->
    <Version>1.0.0</Version>
    <AssemblyTitle>全屏开始菜单</AssemblyTitle>
    <Product>全屏开始菜单</Product>
    <Description>Windows 10 风格的全屏开始菜单</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Update="tiles.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
